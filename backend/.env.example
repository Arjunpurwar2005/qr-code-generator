# PostgreSQL connection string
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Secret Key for authenticating teachers
SECRET_KEY=your_secret_key_here

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Used to verify "Sign in with Google" tokens sent by the frontend.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Secret used to protect the /admin/institutions endpoints and admin.html panel.
# Pick your own strong random value - never share it.
ADMIN_SECRET=your_admin_panel_secret_here
